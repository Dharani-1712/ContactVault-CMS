# ============================================================
# CMS Backend – Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

PORT=5000
FRONTEND_URL=http://localhost:3000

# Firebase Admin SDK (paste the entire JSON as a single line, or use the file path approach)
# Option A: JSON string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT","..."}

# Option B: Path to service account key file (uncomment if using file)
# GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json

FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
